// Prisma schema for PERN Mini ERP

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  schemas  = ["pern_erp"]
}

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["multiSchema"]
}

enum Role {
  ADMIN
  SALES

  @@schema("pern_erp")
}

enum EnquiryStatus {
  NEW
  QUOTED
  WON
  LOST

  @@schema("pern_erp")
}

enum QuotationStatus {
  DRAFT
  SENT
  ACCEPTED
  REJECTED

  @@schema("pern_erp")
}

enum OrderStatus {
  PENDING
  CONFIRMED
  DISPATCHED
  CANCELLED

  @@schema("pern_erp")
}

model User {
  id           Int      @id @default(autoincrement())
  name         String
  email        String   @unique
  passwordHash String   @map("password_hash")
  role         Role     @default(SALES)
  createdAt    DateTime @default(now()) @map("created_at")

  enquiries  Enquiry[]
  quotations Quotation[]
  dispatches Dispatch[]

  @@map("users")
  @@schema("pern_erp")
}

model Customer {
  id            Int      @id @default(autoincrement())
  companyName   String   @map("company_name")
  contactPerson String   @map("contact_person")
  mobile        String
  email         String
  city          String
  createdAt     DateTime @default(now()) @map("created_at")

  enquiries   Enquiry[]
  quotations  Quotation[]
  salesOrders SalesOrder[]

  @@map("customers")
  @@schema("pern_erp")
}

model Product {
  id          Int      @id @default(autoincrement())
  productCode String   @unique @map("product_code")
  productName String   @map("product_name")
  category    String
  unit        String
  basePrice   Decimal  @map("base_price") @db.Decimal(12, 2)
  createdAt   DateTime @default(now()) @map("created_at")

  inventory       Inventory?
  enquiryItems    EnquiryItem[]
  quotationItems  QuotationItem[]
  salesOrderItems SalesOrderItem[]
  dispatchItems   DispatchItem[]

  @@map("products")
  @@schema("pern_erp")
}

model Inventory {
  id          Int      @id @default(autoincrement())
  productId   Int      @unique @map("product_id")
  physicalQty Int      @default(0) @map("physical_qty")
  reservedQty Int      @default(0) @map("reserved_qty")
  updatedAt   DateTime @updatedAt @map("updated_at")

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("inventory")
  @@schema("pern_erp")
}

model Enquiry {
  id            Int           @id @default(autoincrement())
  enquiryNumber String        @unique @map("enquiry_number")
  customerId    Int           @map("customer_id")
  createdById   Int           @map("created_by")
  enquiryDate   DateTime      @default(now()) @map("enquiry_date")
  requiredDate  DateTime      @map("required_date")
  notes         String?
  status        EnquiryStatus @default(NEW)
  createdAt     DateTime      @default(now()) @map("created_at")

  customer  Customer      @relation(fields: [customerId], references: [id])
  createdBy User          @relation(fields: [createdById], references: [id])
  items     EnquiryItem[]
  quotation Quotation?

  @@map("enquiries")
  @@schema("pern_erp")
}

model EnquiryItem {
  id        Int @id @default(autoincrement())
  enquiryId Int @map("enquiry_id")
  productId Int @map("product_id")
  quantity  Int

  enquiry Enquiry @relation(fields: [enquiryId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])

  @@map("enquiry_items")
  @@schema("pern_erp")
}

model Quotation {
  id              Int             @id @default(autoincrement())
  quotationNumber String          @unique @map("quotation_number")
  enquiryId       Int             @unique @map("enquiry_id")
  customerId      Int             @map("customer_id")
  createdById     Int             @map("created_by")
  grandTotal      Decimal         @default(0.00) @map("grand_total") @db.Decimal(14, 2)
  validUntil      DateTime        @map("valid_until")
  status          QuotationStatus @default(DRAFT)
  createdAt       DateTime        @default(now()) @map("created_at")

  enquiry    Enquiry         @relation(fields: [enquiryId], references: [id])
  customer   Customer        @relation(fields: [customerId], references: [id])
  createdBy  User            @relation(fields: [createdById], references: [id])
  items      QuotationItem[]
  salesOrder SalesOrder?

  @@map("quotations")
  @@schema("pern_erp")
}

model QuotationItem {
  id          Int     @id @default(autoincrement())
  quotationId Int     @map("quotation_id")
  productId   Int     @map("product_id")
  quantity    Int
  unitPrice   Decimal @map("unit_price") @db.Decimal(12, 2)
  discountPct Decimal @default(0.00) @map("discount_pct") @db.Decimal(5, 2)
  gstPct      Decimal @default(18.00) @map("gst_pct") @db.Decimal(5, 2)
  lineAmount  Decimal @map("line_amount") @db.Decimal(14, 2)

  quotation Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  product   Product   @relation(fields: [productId], references: [id])

  @@map("quotation_items")
  @@schema("pern_erp")
}

model SalesOrder {
  id          Int         @id @default(autoincrement())
  orderNumber String      @unique @map("order_number")
  customerId  Int         @map("customer_id")
  quotationId Int         @unique @map("quotation_id")
  orderDate   DateTime    @default(now()) @map("order_date")
  totalAmount Decimal     @map("total_amount") @db.Decimal(14, 2)
  status      OrderStatus @default(PENDING)
  createdAt   DateTime    @default(now()) @map("created_at")

  customer   Customer         @relation(fields: [customerId], references: [id])
  quotation  Quotation        @relation(fields: [quotationId], references: [id])
  items      SalesOrderItem[]
  dispatches Dispatch[]

  @@map("sales_orders")
  @@schema("pern_erp")
}

model SalesOrderItem {
  id           Int     @id @default(autoincrement())
  salesOrderId Int     @map("sales_order_id")
  productId    Int     @map("product_id")
  quantity     Int
  unitPrice    Decimal @map("unit_price") @db.Decimal(12, 2)
  lineAmount   Decimal @map("line_amount") @db.Decimal(14, 2)

  salesOrder SalesOrder @relation(fields: [salesOrderId], references: [id], onDelete: Cascade)
  product    Product    @relation(fields: [productId], references: [id])

  @@map("sales_order_items")
  @@schema("pern_erp")
}

model Dispatch {
  id             Int      @id @default(autoincrement())
  dispatchNumber String   @unique @map("dispatch_number")
  salesOrderId   Int      @map("sales_order_id")
  dispatchDate   DateTime @default(now()) @map("dispatch_date")
  vehicleNumber  String   @map("vehicle_number")
  driverName     String   @map("driver_name")
  dispatchedById Int      @map("dispatched_by")
  createdAt      DateTime @default(now()) @map("created_at")

  salesOrder   SalesOrder     @relation(fields: [salesOrderId], references: [id])
  dispatchedBy User           @relation(fields: [dispatchedById], references: [id])
  items        DispatchItem[]

  @@map("dispatches")
  @@schema("pern_erp")
}

model DispatchItem {
  id         Int @id @default(autoincrement())
  dispatchId Int @map("dispatch_id")
  productId  Int @map("product_id")
  quantity   Int

  dispatch Dispatch @relation(fields: [dispatchId], references: [id], onDelete: Cascade)
  product  Product  @relation(fields: [productId], references: [id])

  @@map("dispatch_items")
  @@schema("pern_erp")
}
